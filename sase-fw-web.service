[Unit]
Description=SASE Firewall Rule Explorer Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sase-fw-web
ExecStart=/usr/bin/python3 /opt/sase-fw-web/web_app.py 8080
Restart=always
RestartSec=5
Environment=PORT=8080

[Install]
WantedBy=multi-user.target
